# Copy to .env (gitignored) and fill in. Never commit the real .env.

DT_DB_HOST=127.0.0.1
DT_DB_PORT=3306
DT_DB_NAME=Diamond_company
DT_DB_USER=diamond_app
DT_DB_PASSWORD=

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DT_SESSION_SECRET=

# Address encoded in QR labels. Keep 127.0.0.1 for this computer only;
# use the computer's LAN address (and run uvicorn with --host 0.0.0.0)
# to scan labels with a phone on the same network.
DT_BASE_URL=http://127.0.0.1:8000

# Set to true only when the app is served over HTTPS
# (also turns on HSTS and the __Host- cookie prefix)
DT_SECURE_COOKIES=false

# Other host names the app answers to, comma-separated. The DT_BASE_URL
# host, 127.0.0.1 and localhost are always allowed.
DT_ALLOWED_HOSTS=

# Sessions end after this long without activity, and after this long in total
DT_SESSION_IDLE_MINUTES=60
DT_SESSION_MAX_AGE_HOURS=12

# Only for a MySQL server on another machine: CA bundle to verify its TLS certificate
# DT_DB_SSL_CA=/path/to/ca.pem
