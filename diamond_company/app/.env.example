# Copy to .env (gitignored) and fill in. Never commit the real .env.

DT_DB_HOST=127.0.0.1
DT_DB_PORT=3306
DT_DB_NAME=Diamond_company
DT_DB_USER=diamond_app
DT_DB_PASSWORD=

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DT_SESSION_SECRET=

# Address encoded in QR labels. Keep 127.0.0.1 for this computer only;
# use the computer's LAN address (and run uvicorn with --host 0.0.0.0)
# to scan labels with a phone on the same network.
DT_BASE_URL=http://127.0.0.1:8000

# Set to true only when the app is served over HTTPS
DT_SECURE_COOKIES=false
